#dVVdt = -( ICa(VV) + IK(VV,nn) + ISK(VV,Ca) + IBK(VV,ff) + Ileak(VV) - stim[idx] ) / Cp
- ( gCa * 0.5*(1 + tanh((vv - Vm)/ (2*Sm) )) * (vv - VCa) + gk * nn * (vv - Vk) + gSK * (cc*cc / ( cc*cc + Ks*Ks )) * (vv - Vk) + gBK * ff * (vv - Vk) + gL * (VV - VL) - Iinj ) / Cp  + uu*(Vobs-vv)  
#dnndt = (nn_inf(VV) - nn)/Taun
0.5*(1 + tanh((vv - Vn)/ (2*Sn) ) - 2*nn ) / Taun     
#dffdt = (ff_inf(VV) - ff)/TauBK
0.5*(1 + tanh((vv - Vf)/ (2*Sf) ) - 2*ff ) / TauBK
#dCadt = -fc * (Alpha * ICa(VV) + Kc * Ca )
-fc * (Alpha * gCa * 0.5*(1 + tanh((vv - Vm)/ (2*Sm) )) * (vv - VCa) + Kc * cc )

